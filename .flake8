[flake8]
exclude =
    .git,
    .ipynb_checkpoints,
    __pycache__,
    build,
    dist,
    docs/source/conf.py
max-line-length = 115
# Ignore some style 'errors' produced while formatting by 'black'
ignore = E203, W503

# These two modules intentionally assemble public, import-based namespaces.
per-file-ignores =
    pyCHX/chx_packages.py:F401,F811
    pyCHX/chx_libs.py:F401

    # This old notebook-driven entry point still consumes caller-defined
    # globals. Its imports are explicit; retain that interactive behavior.
    pyCHX/XPCS_XSVS_SAXS_Multi_2017_V4.py:F821
